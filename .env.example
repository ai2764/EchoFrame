WAN_WEIGHT_DTYPE=default

MUSETALK_ROOT=engines/musetalk
MUSETALK_PYTHON=python
MUSETALK_FFMPEG_DIR=
MUSETALK_USE_FLOAT16=true
MUSETALK_CUDA_VISIBLE_DEVICES=0
MUSETALK_FPS=12
MUSETALK_BATCH_SIZE=16
MUSETALK_FAST_IMAGE_INPUT=false

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

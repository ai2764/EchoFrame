APP_HOST=0.0.0.0
APP_PORT=7860
DATA_DIR=data
AVATAR_SIZE=512
OUTPUT_SIZE=320
RESOLUTION_MIN=120
RESOLUTION_MAX=512

LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
LLM_ALLOW_FALLBACK=true
LLM_LOAD_BEFORE_REQUEST=true
LLM_UNLOAD_AFTER_REQUEST=true
LLM_CONTEXT_LENGTH=16384
LLM_FLASH_ATTENTION=true
LLM_OFFLOAD_KV_CACHE_TO_GPU=true
LMS_BIN=lms
LMS_SERVER_HOST=127.0.0.1
LMS_SERVER_PORT=1234
LMS_GPU=max

TTS_URL=http://127.0.0.1:9880
TTS_SECRET=
TTS_ROOT=engines/cosyvoice
TTS_PYTHON=python
TTS_SCRIPT=tts_server.py
TTS_PORT=9880
TTS_DEFAULT_VOICE_ID=4988cee6
TTS_USE_LLM_INSTRUCT=false
TTS_FIXED_INSTRUCT=
TTS_TRIM_START_SECONDS=0.8
TTS_FADE_IN_SECONDS=0.04

COMFY_URL=http://127.0.0.1:8000
COMFY_ROOT=engines/comfyui
COMFY_PYTHON=python
COMFY_BASE_DIR=
COMFY_INPUT_DIR=engines/comfyui/input
COMFY_OUTPUT_DIR=engines/comfyui/output
COMFY_MODELS_DIR=

WAN_WIDTH=320
WAN_HEIGHT=320
WAN_FPS=12
WAN_LOOP_SECONDS=2.75
WAN_HIGH_MODEL=wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors
WAN_LOW_MODEL=wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors
WAN_CLIP_MODEL=umt5_xxl_fp8_e4m3fn_scaled.safetensors
